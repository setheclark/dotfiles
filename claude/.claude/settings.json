{
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-code-notifier/notify.sh input"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-code-notifier/notify.sh choice"
          }
        ]
      }
    ]
  }
}
