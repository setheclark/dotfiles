# =============================================================================
# SSH Configuration
# =============================================================================
#
# This file is managed by dotfiles. Machine-specific hosts should go in:
#   ~/.ssh/config.local (not tracked by git)
#
# Modular configs are loaded from:
#   ~/.ssh/config.d/*.conf

# -----------------------------------------------------------------------------
# Include local and modular configs
# -----------------------------------------------------------------------------

# Local machine-specific config (not tracked in git)
Include config.local

# Modular config files
Include config.d/*.conf

# -----------------------------------------------------------------------------
# Global defaults (apply to all hosts unless overridden)
# -----------------------------------------------------------------------------

Host *
    # Security
    IdentitiesOnly yes
    HashKnownHosts yes

    # Performance
    Compression yes

    # Keep connections alive
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # macOS Keychain integration (ignored on Linux)
    IgnoreUnknown AddKeysToAgent,UseKeychain
    AddKeysToAgent yes
    UseKeychain yes
