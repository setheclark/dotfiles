# =============================================================================
# Local git configuration - Machine-specific settings
# =============================================================================
#
# This file is created automatically during installation.
# Run ./scripts/install.sh to set up your git identity interactively.
#
# This file is NOT tracked by git.
#
# Use this file for:
# - User identity (name and email)
# - Machine-specific git settings
# - Signing configuration
# - Work repository conditional includes

# -----------------------------------------------------------------------------
# User Identity (set during install)
# -----------------------------------------------------------------------------

[user]
    name = Your Name
    email = your.email@example.com

# -----------------------------------------------------------------------------
# Signing commits (optional)
# -----------------------------------------------------------------------------

# GPG signing
# [user]
#     signingkey = YOUR_GPG_KEY_ID
# [commit]
#     gpgsign = true

# SSH signing (GitHub supports this)
# [user]
#     signingkey = ~/.ssh/id_ed25519.pub
# [gpg]
#     format = ssh
# [commit]
#     gpgsign = true

# 1Password SSH signing
# [user]
#     signingkey = ssh-ed25519 AAAA...
# [gpg]
#     format = ssh
# [gpg "ssh"]
#     program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
# [commit]
#     gpgsign = true

# -----------------------------------------------------------------------------
# Work repository configuration (set during install if work machine)
# -----------------------------------------------------------------------------
# If you configured a work identity during install, conditional includes
# will be added below automatically. Example:
#
# [includeIf "hasconfig:remote.*.url:git@github.com:mycompany/**"]
#     path = ~/.gitconfig.work
#
# This automatically uses your work email for repos owned by your company.
