# =============================================================================
# Local SSH Configuration - Machine-specific hosts
# =============================================================================
#
# Copy this file to ~/.ssh/config.local
# This file is NOT tracked by git - safe for sensitive host information
#
# Examples of what to put here:
# - Work servers with internal hostnames
# - Personal servers
# - Jump hosts / bastion servers
# - Hosts with non-standard ports or usernames

# -----------------------------------------------------------------------------
# Personal Servers
# -----------------------------------------------------------------------------

# Example: Personal VPS
# Host myserver
#     HostName 123.45.67.89
#     User deploy
#     IdentityFile ~/.ssh/id_ed25519_personal
#     Port 22

# Example: Raspberry Pi at home
# Host pi homelab
#     HostName 192.168.1.100
#     User pi
#     IdentityFile ~/.ssh/id_ed25519

# -----------------------------------------------------------------------------
# Work Servers (example - customize for your work)
# -----------------------------------------------------------------------------

# Example: Work jump host / bastion
# Host bastion jump
#     HostName bastion.company.com
#     User your.username
#     IdentityFile ~/.ssh/id_ed25519_work
#     ForwardAgent yes

# Example: Internal server via jump host
# Host internal-server
#     HostName internal.company.local
#     User your.username
#     ProxyJump bastion
#     IdentityFile ~/.ssh/id_ed25519_work

# Example: Work dev environment
# Host dev
#     HostName dev.company.com
#     User your.username
#     IdentityFile ~/.ssh/id_ed25519_work
#     LocalForward 3000 localhost:3000
#     LocalForward 8080 localhost:8080

# -----------------------------------------------------------------------------
# 1Password SSH Agent (uncomment if using)
# -----------------------------------------------------------------------------

# To use 1Password as your SSH agent:
# 1. Enable SSH agent in 1Password settings
# 2. Add your SSH keys to 1Password
# 3. Uncomment the following block:

# Host *
#     IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
