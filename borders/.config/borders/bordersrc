#!/bin/bash
# =============================================================================
# JankyBorders Configuration
# =============================================================================
# Window border highlighting for macOS
# https://github.com/FelixKratz/JankyBorders
#

# Border options
options=(
  style=round
  width=5.0
  hidpi=on
  active_color=glow(0xffa6d189)
  inactive_color=0xff303446
)

# Start borders with options
borders "${options[@]}"
